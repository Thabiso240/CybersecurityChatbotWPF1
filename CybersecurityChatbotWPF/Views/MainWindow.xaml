<Window x:Class="CybersecurityChatbotWPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot — PROG6221"
        Width="960" Height="720"
        MinWidth="720" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117"
        FontFamily="Consolas">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Row 0: Top header -->
            <RowDefinition Height="Auto"/>  <!-- Row 1: ASCII art banner -->
            <RowDefinition Height="Auto"/>  <!-- Row 2: Status bar -->
            <RowDefinition Height="*"/>     <!-- Row 3: Chat area -->
            <RowDefinition Height="Auto"/>  <!-- Row 4: Quick topic chips -->
            <RowDefinition Height="Auto"/>  <!-- Row 5: Input area -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════ ROW 0 — HEADER ═══════════════════ -->
        <Border Grid.Row="0"
                Background="#161B22"
                BorderBrush="#00D4FF"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="🛡  CYBERSECURITY AWARENESS BOT"
                               Foreground="#00D4FF"
                               FontSize="19"
                               FontWeight="Bold"/>
                    <TextBlock Text="Keeping South African Citizens Safe Online — PROG6221"
                               Foreground="#8B949E"
                               FontSize="11"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10"
                             Fill="#00FF88"
                             Margin="0,0,7,0"/>
                    <TextBlock Text="ONLINE"
                               Foreground="#00FF88"
                               FontSize="11"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════ ROW 1 — ASCII ART BANNER ═══════════════════ -->
        <Border Grid.Row="1"
                Background="#0D1117"
                BorderBrush="#30363D"
                BorderThickness="0,0,0,1"
                Padding="0,8">
            <TextBlock FontFamily="Consolas"
                       FontSize="8.5"
                       Foreground="#1F6FEB"
                       HorizontalAlignment="Center"
                       TextWrapping="NoWrap"
                       Text=" ____   _                 _                     _             &#x0a;/ ___| | |__    ___    __| |  ___   ___   ___  | |_   ___  ___&#x0a;| |     | '_ \  / _ \  / _` | / _ \ / __| / _ \ | __| / __|/ _ \&#x0a;| |___  | | | || (_) || (_| ||  __/| (__ | (_) || |_  \__ \  __/&#x0a; \____| |_| |_| \___/  \__,_| \___| \___| \___/  \__| |___/\___/"/>
        </Border>

        <!-- ═══════════════════ ROW 2 — STATUS BAR ═══════════════════ -->
        <Border Grid.Row="2"
                Background="#161B22"
                Padding="20,7">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="👤 User: "      Foreground="#8B949E" FontSize="11"/>
                <TextBlock x:Name="UserNameLabel" Text="Guest"        Foreground="#E6EDF3" FontSize="11" FontWeight="Bold"/>

                <TextBlock Text="   │   💬 Mood: " Foreground="#8B949E" FontSize="11"/>
                <TextBlock x:Name="MoodLabel"      Text="Neutral"      Foreground="#00D4FF" FontSize="11"/>

                <TextBlock Text="   │   🎯 Topic: " Foreground="#8B949E" FontSize="11"/>
                <TextBlock x:Name="TopicLabel"      Text="None yet"     Foreground="#00FF88" FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════════ ROW 3 — CHAT AREA ═══════════════════ -->
        <ScrollViewer Grid.Row="3"
                      x:Name="ChatScrollViewer"
                      Background="#0D1117"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="18,8">
            <StackPanel x:Name="ChatPanel"
                        Orientation="Vertical"
                        Margin="0,4"/>
        </ScrollViewer>

        <!-- ═══════════════════ ROW 4 — QUICK TOPIC CHIPS ═══════════════════ -->
        <Border Grid.Row="4"
                Background="#161B22"
                BorderBrush="#30363D"
                BorderThickness="0,1,0,0"
                Padding="18,8">
            <StackPanel>
                <TextBlock Text="Quick topics:"
                           Foreground="#8B949E"
                           FontSize="10"
                           Margin="0,0,0,5"/>
                <WrapPanel x:Name="TopicButtonsPanel" Orientation="Horizontal"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════════ ROW 5 — INPUT AREA ═══════════════════ -->
        <Border Grid.Row="5"
                Background="#161B22"
                BorderBrush="#00D4FF"
                BorderThickness="0,1,0,0"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Text input -->
                <TextBox Grid.Column="0"
                         x:Name="InputBox"
                         Style="{StaticResource ChatInput}"
                         VerticalAlignment="Center"
                         KeyDown="InputBox_KeyDown"
                         TextChanged="InputBox_TextChanged"/>

                <!-- Placeholder text overlay -->
                <TextBlock Grid.Column="0"
                           x:Name="PlaceholderText"
                           Text="Ask about passwords, phishing, privacy, scams..."
                           Foreground="#3D4A5C"
                           FontFamily="Consolas"
                           FontSize="13"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>

                <!-- Clear chat button -->
                <Button Grid.Column="1"
                        x:Name="ClearButton"
                        Content="🗑 Clear"
                        Style="{StaticResource UtilButton}"
                        Margin="8,0,0,0"
                        Click="ClearButton_Click"/>

                <!-- Send button -->
                <Button Grid.Column="2"
                        x:Name="SendButton"
                        Content="Send  ▶"
                        Style="{StaticResource CyberButton}"
                        Margin="8,0,0,0"
                        Click="SendButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
