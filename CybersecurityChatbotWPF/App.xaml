<Application x:Class="CybersecurityChatbotWPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>

        <!-- ═══════════════════════ COLOUR PALETTE ═══════════════════════ -->
        <SolidColorBrush x:Key="DarkBg"      Color="#0D1117"/>
        <SolidColorBrush x:Key="PanelBg"     Color="#161B22"/>
        <SolidColorBrush x:Key="CardBg"      Color="#1C2128"/>
        <SolidColorBrush x:Key="AccentCyan"  Color="#00D4FF"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#00FF88"/>
        <SolidColorBrush x:Key="AccentRed"   Color="#FF4444"/>
        <SolidColorBrush x:Key="AccentBlue"  Color="#1F6FEB"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E6EDF3"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#8B949E"/>
        <SolidColorBrush x:Key="BorderColor" Color="#30363D"/>

        <!-- ═══════════════════════ SEND BUTTON ═══════════════════════ -->
        <Style x:Key="CyberButton" TargetType="Button">
            <Setter Property="Background"   Value="#1F6FEB"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="FontFamily"   Value="Consolas"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="FontWeight"   Value="Bold"/>
            <Setter Property="Padding"      Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#388BFD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0D4DB8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#2D333B"/>
                                <Setter Property="Foreground" Value="#4A5568"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════ CLEAR / UTILITY BUTTON ═══════════════════════ -->
        <Style x:Key="UtilButton" TargetType="Button" BasedOn="{StaticResource CyberButton}">
            <Setter Property="Background" Value="#1C2128"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="Padding"    Value="14,10"/>
        </Style>

        <!-- ═══════════════════════ QUICK TOPIC CHIP ═══════════════════════ -->
        <Style x:Key="TopicButton" TargetType="Button">
            <Setter Property="Background"        Value="#1C2128"/>
            <Setter Property="Foreground"        Value="#00D4FF"/>
            <Setter Property="FontFamily"        Value="Consolas"/>
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="Padding"           Value="10,5"/>
            <Setter Property="Margin"            Value="3,2"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="BorderBrush"       Value="#30363D"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background"    Value="#00D4FF"/>
                                <Setter Property="Foreground" Value="#0D1117"/>
                                <Setter TargetName="Chip" Property="BorderBrush"   Value="#00D4FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chip" Property="Background"    Value="#009AB8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════ CHAT INPUT BOX ═══════════════════════ -->
        <Style x:Key="ChatInput" TargetType="TextBox">
            <Setter Property="Background"        Value="#1C2128"/>
            <Setter Property="Foreground"        Value="#E6EDF3"/>
            <Setter Property="CaretBrush"        Value="#00D4FF"/>
            <Setter Property="FontFamily"        Value="Consolas"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="Padding"           Value="12,10"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="BorderBrush"       Value="#30363D"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#00D4FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════ SLIM SCROLLBAR ═══════════════════════ -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width"      Value="5"/>
            <Setter Property="MinWidth"   Value="5"/>
        </Style>

    </Application.Resources>
</Application>
